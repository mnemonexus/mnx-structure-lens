{
  "schemaVersion": "mnxpack_manifest_v1",
  "id": "structure-lens",
  "version": "0.1.0",
  "kind": "experience",
  "label": "Structure Lens",
  "description": "Practise pointing at the right thing. Name the hidden labels on the lecture's own diagrams, or turn a real 3D structure and click the feature asked for: the catalytic serine, the oxyanion hole, the rudder, the active-site metal. Private study pack built from course material and public PDB entries.",
  "tagline": "Label the figure. Find it in the structure.",
  "icon": "fa-solid fa-dna",
  "author": "Private study pack for one student",
  "subjects": [
    "biochemistry",
    "molecular biology",
    "structural biology",
    "genome expression and maintenance",
    "biochemical reactions and interactions"
  ],
  "knowledgeBinding": {
    "mode": "none"
  },
  "surfaces": {},
  "practice": {
    "version": 1,
    "catalogue": "assets/practice/catalogue.json"
  },
  "permissions": [
    "storage:local",
    "render:3d"
  ],
  "settings": [
    {
      "id": "labelAnswers",
      "label": "Answering a label",
      "description": "Type each label from memory, or pick it from a word bank. Typing is the harder and better practice.",
      "type": "choice",
      "default": "type",
      "options": [
        {
          "value": "type",
          "label": "Type it"
        },
        {
          "value": "pick",
          "label": "Pick from a word bank"
        }
      ]
    },
    {
      "id": "showHints",
      "label": "Show hints",
      "description": "Hints say what to look for, never the answer. Using one is recorded.",
      "type": "toggle",
      "default": true
    },
    {
      "id": "lighter",
      "label": "Lighter 3D drawing",
      "description": "Draw structures as a thin trace. Turn this on if a large structure turns slowly.",
      "type": "toggle",
      "default": false
    }
  ],
  "engines": {
    "mnxSdk": "1.0.0"
  },
  "entry": {
    "logicalPath": "code/main.cjs"
  },
